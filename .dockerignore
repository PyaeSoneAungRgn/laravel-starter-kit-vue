# Keep the build context small. Without this file the context includes
# node_modules, vendor and the local FrankenPHP binary, which slows every build
# and lets host artifacts overwrite what the image just installed.

# --- VCS / tooling / docs ---
.git
.github
.ai
.agents
.husky
.editorconfig
.prettierrc
.prettierignore
eslint.config.js
lint-staged.config.js
phpstan.neon
rector.php
duster.json
boost.json
opencode.json
skills-lock.json
.DS_Store

# --- Dependencies: installed inside the image ---
# The **/ forms cover nested copies (e.g. inside app-modules).
node_modules
**/node_modules
vendor
**/vendor
.npm-cache
.composer-cache
.composer-home

# --- Octane: the worker bootstrap is generated by the Dockerfile ---
frankenphp
**/caddy
public/frankenphp-worker.php

# --- Build output and runtime state: produced inside the image ---
public/build
public/hot
public/storage
storage/logs/*
!storage/logs/.gitignore
storage/pail/*
!storage/pail/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
bootstrap/cache/*
!bootstrap/cache/.gitignore
.phpunit.cache

# Add project-specific artifacts below, e.g. a browser cache directory if you
# introduce Puppeteer/Browsershot.
