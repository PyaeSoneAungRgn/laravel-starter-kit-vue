includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:

    paths:
        - app/
        - app-modules/

    # Test helper functions live in tests/Pest.php and are not autoloaded, so
    # they must be scanned for the helpers used by module tests to resolve.
    scanDirectories:
        - tests/

    # Level 10 is the highest level
    level: 5

#    ignoreErrors:
#        - '#PHPDoc tag @var#'
#
#    excludePaths:
#        - ./*/*/FileToBeExcluded.php
